{
  "name": "empirical-cases",
  "type": "module",
  "version": "0.4.0",
  "description": "A lightweight, intuitive, straightforward, yet flexible data‑driven test runner, compatible with Vitest, Jest, Mocha and any framework that provides similar test function.",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown --minify",
    "coverage": "vitest run --coverage",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "tdd": "vitest",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amobiz/empirical-cases.git"
  },
  "keywords": [
    "cases",
    "jest",
    "json",
    "mocha",
    "runner",
    "test",
    "vitest"
  ],
  "author": "Amobiz <amobiz.tw+github@gmail.com> (https://github.com/amobiz)",
  "contributors": [
    "Ivan Sosnin <vansosnin@gmail.com> (https://github.com/vansosnin)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/amobiz/empirical-cases/issues"
  },
  "homepage": "https://github.com/amobiz/empirical-cases#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^18.19.130",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
